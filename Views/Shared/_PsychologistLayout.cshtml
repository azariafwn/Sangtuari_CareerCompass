<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sangtuari Psikolog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Menggunakan Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --bg-purple: #4A2B50;
            --bg-yellow: #FBE676;
            --bg-light: #FFFDF4;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        #wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
            min-height: 100vh;
        }

        /* Sidebar Styles */
        #sidebar-wrapper {
            min-width: 250px;
            max-width: 250px;
            background-color: var(--bg-purple);
            color: white;
            transition: all 0.3s;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

            #sidebar-wrapper.toggled {
                min-width: 70px;
                max-width: 70px;
            }

                #sidebar-wrapper.toggled .brand-text,
                #sidebar-wrapper.toggled .menu-text {
                    display: none;
                }

        .sidebar-heading {
            padding: 1.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .list-group-item {
            background-color: transparent;
            border: none;
            color: rgba(255,255,255,0.8);
            padding: 15px 20px;
            transition: 0.2s;
            white-space: nowrap;
        }

            .list-group-item:hover, .list-group-item.active {
                background-color: rgba(251, 230, 118, 0.1);
                color: var(--bg-yellow);
                font-weight: bold;
                border-left: 4px solid var(--bg-yellow);
            }

            .list-group-item i {
                font-size: 1.2rem;
                margin-right: 10px;
            }

        #sidebar-wrapper.toggled .list-group-item i {
            margin-right: 0;
            text-align: center;
            display: block;
        }

        /* Page Content Styles */
        #page-content-wrapper {
            width: 100%;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background-color: white;
            border-bottom: 1px solid #ddd;
            padding: 15px 25px;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .btn-burger {
            background-color: transparent;
            border: none;
            color: var(--bg-purple);
            font-size: 1.5rem;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar-wrapper" class="shadow">
            <div class="sidebar-heading d-flex align-items-center justify-content-center">
                <img src="~/images/logo-sangtuari.png" alt="Logo" width="35" class="bg-white rounded-circle p-1 me-2" onerror="this.style.display='none'">
                <span class="brand-text fw-bold fst-italic fs-5" style="color: var(--bg-yellow);">Sangtuari</span>
            </div>
            <div class="list-group list-group-flush mt-3">
                <a href="/Psychologist/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i> <span class="menu-text">Dashboard</span>
                </a>
                <a href="/Psychologist/Queue" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Queue" ? "active" : "")">
                    <i class="bi bi-list-check"></i> <span class="menu-text">Antrean Penilaian</span>
                </a>
                <a href="/Psychologist/ParticipantList" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "ParticipantList" ? "active" : "")">
                    <i class="bi bi-people-fill"></i> <span class="menu-text">Data Peserta</span>
                </a>
                <a href="/Psychologist/Profile" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                    <i class="bi bi-person-badge-fill"></i> <span class="menu-text">Profil Psikolog</span>
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-custom shadow-sm">
                <button class="btn-burger" id="menu-toggle"><i class="bi bi-list"></i></button>
                <div class="ms-auto d-flex align-items-center">
                    <span class="fw-bold text-muted me-3">Halo, @User.Identity?.Name!</span>
                    <a href="/Psychologist/Logout" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">Keluar</a>
                </div>
            </nav>

            <div class="container-fluid p-4 flex-grow-1">
                @RenderBody()
            </div>
        </div>
    </div>

    <script>
        // Logika Toggle Sidebar Burger Menu
        document.getElementById("menu-toggle").addEventListener("click", function (e) {
            e.preventDefault();
            document.getElementById("sidebar-wrapper").classList.toggle("toggled");
        });
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>