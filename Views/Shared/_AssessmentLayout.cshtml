<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Sangtuari</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: #FFE375;
            overflow-x: hidden;
        }

        .bg-purple-brand {
            background-color: #4E325A;
        }

        .text-yellow-brand {
            color: #FFE375 !important;
        }

        .bg-input-custom {
            background-color: #FFFDF4 !important;
        }

        .btn-purple-custom {
            background-color: #9C7BB4;
            color: white;
            transition: all 0.2s ease;
        }

            .btn-purple-custom:hover {
                background-color: #85629D;
                color: white;
            }

        .hover-card-select {
            transition: all 0.2s ease;
            background-color: #FFFDF4;
            border: none;
            color: #4E325A !important;
        }

            .hover-card-select:hover {
                transform: translateY(-2px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
                color: #4E325A !important;
            }

        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(78, 50, 90, 0.2);
            border: 1px solid #4E325A !important;
            background-color: #ffffff !important;
        }

        .text-nowrap-custom {
            white-space: nowrap;
        }

        /* ================= FLUID TYPOGRAPHY UNTUK LAYAR BESAR ================= */
        /* H1 Utama: Minimum 1.75rem (mobile), ideal 3.5vw, maksimum 3.75rem (desktop besar) */
        .fluid-title {
            font-size: clamp(1.75rem, 3.5vw, 3.75rem);
            line-height: 1.1;
        }

        /* H2 Sub-title: Minimum 1.1rem, ideal 1.8vw, maksimum 1.75rem */
        .fluid-subtitle {
            font-size: clamp(1.1rem, 1.8vw, 1.75rem);
        }

        /* Deskripsi Paragraf Peningkat Keterbacaan Layar Lebar */
        .fluid-desc {
            font-size: clamp(0.95rem, 1.1vw, 1.2rem);
        }
    </style>
</head>
<body>

    <div class="container-fluid min-vh-100 d-flex p-0 m-0">
        <div class="d-flex flex-column flex-md-row w-100 m-0">

            <!-- ================= TEMPLATE FIXED KIRI / ATAS ================= -->
            <div class="col-12 col-md-5 d-flex flex-row flex-md-column justify-content-start justify-content-md-center align-items-center align-items-md-start text-white p-3 p-md-4 bg-purple-brand gap-3 gap-md-0">

                <!-- Logo Bundar -->
                <a href="@Url.Action("Index", "Assessment")" class="d-inline-flex align-items-center justify-content-center shadow-sm rounded-circle bg-white p-1 mb-0 mb-md-4" style="width: 80px; height: 80px; min-width: 80px; max-width: 150px; max-height: 150px; width: clamp(80px, 12vw, 150px); height: clamp(80px, 12vw, 150px);">
                    <img src="~/images/logo-sangtuari.png" alt="Logo Sangtuari" class="img-fluid rounded-circle">
                </a>

                <!-- Kontainer Teks Beradaptasi Responsif -->
                <div class="d-flex flex-column align-items-start w-100">
                    <h2 class="fw-normal m-0 text-start opacity-75 fluid-subtitle">Selamat Datang di</h2>
                    <h1 class="fw-bold fst-italic tracking-tight text-start my-1 my-md-3 fluid-title">
                        <span class="text-white text-nowrap-custom">Sangtuari's</span><br class="d-md-block" />
                        <span class="text-yellow-brand text-nowrap-custom">Career Compass</span>
                    </h1>
                    <!-- Deskripsi Deskriptif Otomatis Proporsional di Monitor Besar -->
                    <p class="opacity-75 fw-normal text-start lh-base mt-2 d-none d-md-block fluid-desc" style="max-width: 450px;">
                        Psikotes <em>online</em> untuk membantumu mengenali potensi, minat, kepribadian, serta arah pendidikan dan karier yang paling sesuai.
                    </p>
                </div>

            </div>

            <!-- ================= KANAN / BAWAH DINAMIS ================= -->
            <div class="col-12 col-md-7 d-flex align-items-center justify-content-center p-4 p-md-5">
                <div class="w-100" style="max-width: 580px;">
                    @RenderBody()
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>