<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Sangtuari Assessment</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: #FFFDF4;
            color: #4E325A;
        }

        .quiz-header {
            background-color: #4E325A;
            color: white;
        }

        .text-yellow-brand {
            color: #FFE375 !important;
        }

        .btn-purple-custom {
            background-color: #9C7BB4;
            color: white;
            border: none;
        }

            .btn-purple-custom:hover {
                background-color: #85629D;
                color: white;
            }

        .option-card {
            border: 2px solid #EFE8D8;
            background-color: #ffffff;
            border-radius: 12px;
            padding: 14px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .option-card:hover, .option-card.active {
                border-color: #4E325A;
                background-color: #F5EBF8;
            }

        .form-check-input:checked {
            background-color: #4E325A;
            border-color: #4E325A;
        }
    </style>
</head>
<body>    
    <!-- Header Ringkas (Sticky Mobile) -->
    <header class="quiz-header py-3 px-3 px-md-5 shadow-sm sticky-top d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <img src="~/images/logo-sangtuari.png" alt="Logo" class="rounded-circle bg-white" style="width: 40px; height: 40px;">
            <span class="fw-bold fs-6 tracking-wide text-yellow-brand">@ViewData["SubTestName"]</span>
        </div>

        <!-- Pastikan id disini adalah "timerDisplay" agar sinkron dengan script di Eas1.cshtml -->
        <div class="badge rounded-pill bg-purple-main text-warning px-3 py-2 fs-6 fw-bold border border-warning">
            <span id="timerDisplay">-- : --</span>
        </div>
    </header>

    <!-- Kontainer Soal Utama -->
    <main class="container my-4 my-md-5" style="max-width: 760px;">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>