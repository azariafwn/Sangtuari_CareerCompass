@model IEnumerable<SangtuariCareerCompass.Models.PsychologistUser>
@{
    ViewData["Title"] = "Manajemen Akun Psikolog";
    Layout = "_PsychologistLayout";
}

<div class="bg-white p-4 rounded-4 shadow-sm d-flex flex-column" style="max-height: 85vh;">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-shrink-0">
        <h4 class="fw-bold mb-0" style="color: #4A2B50;">Manajemen Akun Psikolog</h4>
        <button type="button" class="btn text-white fw-bold rounded-pill px-4" style="background-color: #9C7BB4;" data-bs-toggle="modal" data-bs-target="#addAccountModal">
            <i class="bi bi-person-plus-fill me-1"></i> Tambah Akun
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive flex-grow-1" style="overflow-y: auto;">
        <table class="table table-hover align-middle mb-0">
            <thead style="position: sticky; top: 0; z-index: 10;">
                <tr class="align-middle">
                    <th width="20%" style="background-color: #4A2B50; color: white; border-bottom: none;">Nama Lengkap</th>
                    <th width="20%" style="background-color: #4A2B50; color: white; border-bottom: none;">Email</th>
                    <th width="15%" class="text-center" style="background-color: #4A2B50; color: white; border-bottom: none;">Role</th>
                    <th width="15%" class="text-center" style="background-color: #4A2B50; color: white; border-bottom: none;">Tgl Dibuat</th>
                    <th width="15%" class="text-center" style="background-color: #4A2B50; color: white; border-bottom: none;">Status</th>
                    <th width="15%" class="text-center" style="background-color: #4A2B50; color: white; border-bottom: none;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    // Efek visual jika dinonaktifkan
                    var rowOpacity = user.IsActive ? "1" : "0.6";

                    <tr style="opacity: @rowOpacity;">
                        <td class="fw-bold">@user.FullName</td>
                        <td class="text-muted">@user.Email</td>
                        <td class="text-center">
                            @if (user.Role == "Head")
                            {
                                <span class="badge rounded-pill bg-danger">Head</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-info text-dark">Staff</span>
                            }
                        </td>
                        <td class="text-center small text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-center">
                            @if (user.IsActive)
                            {
                                <span class="text-success small fw-bold"><i class="bi bi-person-check-fill"></i> Aktif</span>
                            }
                            else
                            {
                                <span class="text-danger small fw-bold"><i class="bi bi-person-x-fill"></i> Nonaktif</span>
                            }
                        </td>
                        <td class="text-center">
                            @{
                                var btnClass = user.IsActive ? "btn-outline-danger" : "btn-outline-success";
                                var btnIcon = user.IsActive ? "bi-lock-fill" : "bi-unlock-fill";
                                var btnText = user.IsActive ? "Deactivate" : "Activate";
                            }
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-sm @btnClass rounded-pill px-3 fw-bold"
                                        onclick="openToggleModal('@user.Id', '@user.Email', '@user.Role', @user.IsActive.ToString().ToLower())">
                                    <i class="bi @btnIcon"></i> @btnText
                                </button>

                                <!-- HANYA MUNCUL JIKA BUKAN HEAD -->
                                @if (user.Role != "Head")
                                {
                                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold shadow-sm"
                                            onclick="openDeleteModal('@user.Id', '@user.Email')">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Tambah Akun -->
<div class="modal fade" id="addAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0" style="background-color: #4A2B50; color: white;">
                <h5 class="modal-title fw-bold">Tambah Akun Psikolog Baru</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddAccount" asp-controller="Psychologist" method="post">
                <div class="modal-body p-4 bg-light">
                    <div class="alert text-dark small rounded-3 border-0 mb-4" style="background-color: #FBE676;">
                        <i class="bi bi-info-circle-fill me-1"></i> Password akan di-generate secara otomatis dan dikirimkan ke email tujuan.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Nama Lengkap</label>
                        <input type="text" name="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Email Aktif</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Role / Hak Akses</label>
                        <select name="Role" class="form-select" required>
                            <option value="Staff">Staff Psikolog</option>
                            <option value="Head">Head Psikolog</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-end bg-light pb-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn text-white rounded-pill px-4 fw-bold" style="background-color: #4A2B50;">Simpan & Kirim Akses</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Toggle Status -->
<div class="modal fade" id="toggleStatusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0" id="toggleModalHeader">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-exclamation-triangle-fill me-2"></i> Konfirmasi Aksi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ToggleAccountStatus" asp-controller="Psychologist" method="post">
                <div class="modal-body p-4 bg-light text-center">
                    <input type="hidden" name="id" id="toggleUserId" />

                    <p class="mb-3">Apakah Anda yakin ingin <strong id="actionVerbText"></strong> akun dengan akses berikut?</p>

                    <div class="bg-white border rounded-3 p-3 mb-3 d-inline-block text-start">
                        <div class="mb-1"><span class="text-muted small">Email:</span> <strong id="targetEmail"></strong></div>
                        <div><span class="text-muted small">Akses:</span> <strong id="targetRole"></strong></div>
                    </div>

                    <p class="small text-muted mb-0" id="actionWarningText"></p>
                </div>
                <div class="modal-footer border-0 justify-content-center bg-light pb-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn text-white rounded-pill px-4 fw-bold" id="btnConfirmToggle"></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Hapus Akun Permanen -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0" style="background-color: #dc3545;">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-exclamation-octagon-fill me-2"></i> Hapus Akun Permanen</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="DeleteAccount" asp-controller="Psychologist" method="post">
                <div class="modal-body p-4 bg-light text-center">
                    <input type="hidden" name="id" id="deleteUserId" />

                    <p class="mb-3">Tindakan ini <strong>TIDAK DAPAT DIBATALKAN</strong>. Apakah Anda yakin ingin menghapus akun ini beserta seluruh aksesnya?</p>

                    <div class="bg-white border border-danger rounded-3 p-3 mb-3 d-inline-block text-start">
                        <div class="mb-1"><span class="text-muted small">Email yang akan dihapus:</span></div>
                        <div><strong id="deleteTargetEmail" class="text-danger fs-5"></strong></div>
                    </div>

                    <p class="small text-muted mb-0">*Sistem akan menghapus data kredensial ini sepenuhnya.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center bg-light pb-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Ya, Hapus Permanen</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openToggleModal(id, email, role, isActive) {
        document.getElementById('toggleUserId').value = id;
        document.getElementById('targetEmail').innerText = email;
        document.getElementById('targetRole').innerText = role;

        const header = document.getElementById('toggleModalHeader');
        const actionVerb = document.getElementById('actionVerbText');
        const warning = document.getElementById('actionWarningText');
        const btnSubmit = document.getElementById('btnConfirmToggle');

        if (isActive) {
            header.style.backgroundColor = '#dc3545'; // Merah
            actionVerb.innerText = "MENONAKTIFKAN (Deactivate)";
            actionVerb.className = "text-danger";
            warning.innerText = "*Akun ini akan langsung ter-logout dan tidak bisa mengakses sistem hingga diaktifkan kembali.";
            btnSubmit.style.backgroundColor = '#dc3545';
            btnSubmit.innerText = "Ya, Nonaktifkan";
        } else {
            header.style.backgroundColor = '#198754'; // Hijau
            actionVerb.innerText = "MENGAKTIFKAN KEMBALI (Activate)";
            actionVerb.className = "text-success";
            warning.innerText = "*Akun ini akan mendapatkan kembali akses masuk ke dalam sistem dengan password terakhirnya.";
            btnSubmit.style.backgroundColor = '#198754';
            btnSubmit.innerText = "Ya, Aktifkan";
        }

        var toggleModal = new bootstrap.Modal(document.getElementById('toggleStatusModal'));
        toggleModal.show();
    }

    function openDeleteModal(id, email) {
        document.getElementById('deleteUserId').value = id;
        document.getElementById('deleteTargetEmail').innerText = email;

        var deleteModal = new bootstrap.Modal(document.getElementById('deleteAccountModal'));
        deleteModal.show();
    }
</script>