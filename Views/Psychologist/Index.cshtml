@{
    ViewData["Title"] = "Dashboard";
    Layout = "_PsychologistLayout";
}

<h3 class="fw-bold mb-4" style="color: var(--bg-purple);">Overview Penilaian</h3>

<div class="row">
    <!-- Panel Statistik -->
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100" style="background-color: var(--bg-purple); color: white;">
            <div class="card-body d-flex flex-column justify-content-center align-items-center p-4">
                <i class="bi bi-file-earmark-person fs-1 mb-2" style="color: var(--bg-yellow);"></i>
                <h2 class="display-4 fw-bold mb-0">@ViewBag.TotalQueue</h2>
                <p class="text-white-50 mb-0">Total Peserta Discovery</p>
            </div>
        </div>
    </div>

    <!-- Panel Pengumuman -->
    <div class="col-md-8 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-megaphone-fill text-warning me-2"></i> Papan Pengumuman</h5>
                <div class="alert alert-info rounded-3 border-0 bg-opacity-10 text-dark">
                    <strong>Pembaruan Sistem (Contoh):</strong> <br />
                    Tenggat waktu penilaian untuk batch SMAN 1 Bogor diperpanjang hingga Jumat, pukul 15:00 WIB. Mohon segera memproses antrean IST dan PAPI Kostick.
                </div>
            </div>
        </div>
    </div>
</div>