@{
    ViewData["Title"] = "Dashboard";
    Layout = "_PsychologistLayout";
}

<h3 class="fw-bold mb-4" style="color: var(--bg-purple);">Overview</h3>

<!-- Papan Pengumuman -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <h5 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-megaphone-fill text-warning me-2"></i> Papan Pengumuman</h5>
        <div class="alert rounded-3 border-0 bg-opacity-10 text-dark mb-0" style="background-color: #d1ecf1;">
            <strong>Pembaruan Sistem:</strong> <br />
            Tenggat waktu penilaian untuk batch SMAN 1 Bogor diperpanjang hingga Jumat, pukul 15:00 WIB. Mohon prioritas penyelesaian antrean IST dan PAPI Kostick pada menu samping.
        </div>
    </div>
</div>

<!-- Grid Statistik -->
<div class="row g-4 mb-4">

    <!-- Total Peserta (All) -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2" style="background-color: white; border-left: 5px solid var(--bg-purple) !important;">
            <div class="card-body d-flex align-items-center">
                <!-- Perbaikan Flexbox untuk Center Icon -->
                <div class="rounded-circle me-3 d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: #FFFDF4; width: 60px; height: 60px;">
                    <i class="bi bi-people-fill fs-3" style="color: var(--bg-purple);"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalPeserta</h3>
                    <p class="text-muted mb-0 small text-uppercase fw-bold">Total Peserta Ujian</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Sekolah -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2" style="background-color: white; border-left: 5px solid var(--bg-purple) !important;">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle me-3 d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: #FFFDF4; width: 60px; height: 60px;">
                    <i class="bi bi-buildings-fill fs-3" style="color: var(--bg-purple);"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalSekolah</h3>
                    <p class="text-muted mb-0 small text-uppercase fw-bold">Total Sekolah Peserta</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Peserta Exploration -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2" style="background-color: white; border-left: 5px solid var(--bg-yellow) !important;">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle me-3 d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: var(--bg-yellow); width: 60px; height: 60px;">
                    <i class="bi bi-compass fs-3" style="color: var(--bg-purple);"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalExploration</h3>
                    <p class="text-muted mb-0 small text-uppercase fw-bold">Exploration (SMP)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Peserta Discovery -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2" style="background-color: white; border-left: 5px solid var(--bg-yellow) !important;">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle me-3 d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: var(--bg-yellow); width: 60px; height: 60px;">
                    <i class="bi bi-search fs-3" style="color: var(--bg-purple);"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalDiscovery</h3>
                    <p class="text-muted mb-0 small text-uppercase fw-bold">Discovery (SMA)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Antrean IST -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2" style="background-color: #4A2B50; color: white;">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle me-3 d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: rgba(255,255,255,0.1); width: 60px; height: 60px;">
                    <i class="bi bi-hourglass-split fs-3" style="color: #FBE676;"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">@ViewBag.UnjudgedIst</h3>
                    <p class="mb-0 small text-uppercase fw-bold opacity-75">Antrean IST Yang Perlu Dinilai</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Antrean PAPI -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2" style="background-color: #4A2B50; color: white;">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle me-3 d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: rgba(255,255,255,0.1); width: 60px; height: 60px;">
                    <i class="bi bi-list-check fs-3" style="color: #FBE676;"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-warning">@ViewBag.UnjudgedPapi</h3>
                    <p class="mb-0 small text-uppercase fw-bold opacity-75">Antrean PAPI Yang Perlu Dinilai</p>
                </div>
            </div>
        </div>
    </div>
</div>