@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Data Peserta & Hasil";
    Layout = "_PsychologistLayout";
}

<div class="bg-white p-4 rounded-4 shadow-sm d-flex flex-column" style="max-height: 85vh;">

    <!-- Header Area: Judul, Filter, Pencarian & Aksi Massal -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-shrink-0">
        <h4 class="fw-bold mb-0" style="color: #4A2B50;">Data Peserta & Hasil Tes</h4>

        <div class="d-flex gap-2 justify-content-end align-items-center">

            <!-- Tombol Hapus Massal (Disembunyikan default) -->
            @if (User.IsInRole("Head"))
            {
                <button id="btnBulkDelete" class="btn btn-danger d-none me-2" onclick="submitBulkDelete()">
                    <i class="bi bi-trash-fill"></i> Hapus Terpilih (<span id="bulkCount">0</span>)
                </button>
            }

            <!-- Filter Jenis Tes -->
            <select id="filterProgram" class="form-select bg-light border-0 text-muted" style="width: 170px; cursor: pointer;">
                <option value="">Semua Program</option>
                <option value="exploration">Exploration (SMP)</option>
                <option value="discovery">Discovery (SMA)</option>
                <option value="advanced">Advanced</option>
            </select>

            <!-- Pencarian -->
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="searchParticipant" class="form-control border-start-0 bg-light" placeholder="Cari peserta / sekolah">
            </div>
        </div>
    </div>

    <!-- Area Scroll Khusus Tabel -->
    <div class="table-responsive flex-grow-1" style="overflow-y: auto;">
        <table class="table table-hover align-middle mb-0" id="participantTable">
            <thead style="position: sticky; top: 0; z-index: 10;">
                <tr class="align-middle">

                    <!-- Checkbox All -->
                    @if (User.IsInRole("Head"))
                    {
                        <th width="3%" class="text-center" style="background-color: #4A2B50; color: white; border-bottom: none;">
                            <input class="form-check-input" type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)">
                        </th>
                    }

                    <th class="text-center" onclick="sortTable(@(User.IsInRole("Head") ? 1 : 0))" width="12%" style="background-color: #4A2B50; color: white; border-bottom: none; cursor: pointer;">
                        Jenis Tes <i class="bi bi-arrow-down-up ms-1 small opacity-50"></i>
                    </th>
                    <th class="text-center" onclick="sortTable(@(User.IsInRole("Head") ? 2 : 1))" width="15%" style="background-color: #4A2B50; color: white; border-bottom: none; cursor: pointer;">
                        Waktu Tes <i class="bi bi-arrow-down-up ms-1 small opacity-50"></i>
                    </th>
                    <th class="text-center" onclick="sortTable(@(User.IsInRole("Head") ? 3 : 2))" width="18%" style="background-color: #4A2B50; color: white; border-bottom: none; cursor: pointer;">
                        Nama Lengkap <i class="bi bi-arrow-down-up ms-1 small opacity-50"></i>
                    </th>
                    <th class="text-center" width="8%" style="background-color: #4A2B50; color: white; border-bottom: none;">Gender</th>
                    <th class="text-center" width="12%" style="background-color: #4A2B50; color: white; border-bottom: none;">Tgl Lahir</th>
                    <th class="text-center" onclick="sortTable(@(User.IsInRole("Head") ? 6 : 5))" width="12%" style="background-color: #4A2B50; color: white; border-bottom: none; cursor: pointer;">
                        Sekolah <i class="bi bi-arrow-down-up ms-1 small opacity-50"></i>
                    </th>
                    <th class="text-center" width="8%" style="background-color: #4A2B50; color: white; border-bottom: none;">Kelas</th>
                    <th class="text-center" width="12%" style="background-color: #4A2B50; color: white; border-bottom: none;">Laporan Akhir</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Checkbox Item -->
                        @if (User.IsInRole("Head"))
                        {
                            <td class="text-center">
                                <input class="form-check-input chk-participant" type="checkbox" value="@item.Id" onchange="toggleBulkDeleteBtn()">
                            </td>
                        }

                        <td>
                            @if (item.AssessmentType == "Exploration")
                            {
                                <span class="badge rounded-pill fw-bold border px-3 py-2" style="background-color: #FBE676; color: #4A2B50; border-color: #4A2B50 !important; font-size: 0.85rem;">Exploration</span>
                            }
                            else if (item.AssessmentType == "Discovery")
                            {
                                <span class="badge rounded-pill fw-bold px-3 py-2" style="background-color: #4A2B50; color: #FBE676; font-size: 0.85rem;">Discovery</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2" style="font-size: 0.85rem;">Advanced</span>
                            }
                        </td>
                        <td data-sort="@item.CreatedAtSort" class="text-muted small text-center">@item.CreatedAtDisplay</td>
                        <td class="fw-bold">@item.FullName</td>
                        <td class="text-center">@item.Gender</td>
                        <td class="text-center">@item.BirthDate</td>
                        <td class="text-center">@item.SchoolName</td>
                        <td class="text-center">@item.ClassName</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                @if (item.IsFullyJudged)
                                {
                                    var reportAction = item.AssessmentType == "Exploration" ? "FinalReportSMP" : "FinalReportSMA";
                                    <a href="/Report/@reportAction?userAssessmentId=@item.Id" class="btn btn-sm text-white rounded-pill px-4 fw-bold" style="background-color: #9C7BB4;" target="_blank">Lihat Hasil</a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4 fw-bold opacity-50" onclick="showCustomAlert('@item.MissingTestsMessage')">
                                        <i class="bi bi-lock-fill me-1"></i> Terkunci
                                    </button>
                                }

                                @if (User.IsInRole("Head"))
                                {
                                    <form asp-controller="Psychologist" asp-action="DeleteParticipant" method="post" class="m-0" onsubmit="return confirm('PERINGATAN KRITIKAL:\n\nYakin ingin menghapus peserta @item.FullName?\n\nSemua jawaban JSONB dan hasil tes yang terikat pada peserta ini akan ikut terhapus permanen dari database.');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger rounded-circle" title="Hapus Data Peserta">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Kustom Bootstrap (Bagus & Di Tengah) -->
<div class="modal fade" id="incompleteModal" tabindex="-1" aria-labelledby="incompleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header border-0" style="background-color: #4A2B50; color: white;">
                <h5 class="modal-title fw-bold" id="incompleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Laporan Terkunci
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center bg-light">
                <p class="mb-3 text-muted">Laporan akhir belum dapat dicetak karena komponen tes berikut belum dinilai oleh Psikolog:</p>
                <h5 id="missingTestsText" class="fw-bold px-3 py-2 rounded-3 d-inline-block" style="background-color: #FBE676; color: #4A2B50;"></h5>
                <p class="small text-muted mt-3 mb-0">Silakan proses penilaian melalui menu <strong>Antrean Penilaian</strong> terlebih dahulu.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center bg-light pb-4">
                <button type="button" class="btn fw-bold rounded-pill px-5" style="background-color: #4A2B50; color: white;" data-bs-dismiss="modal">Mengerti</button>
            </div>
        </div>
    </div>
</div>

<!-- HIDDEN FORM UNTUK BULK DELETE -->
@if (User.IsInRole("Head"))
{
    <form id="bulkDeleteForm" asp-controller="Psychologist" asp-action="DeleteMultipleParticipants" method="post" class="d-none">
        <!-- Input token anti-forgery dan ID peserta akan di-inject via JS -->
    </form>
}

<script>
    // --- LOGIKA FILTER GABUNGAN ---
    function applyFilters() {
        let searchText = document.getElementById('searchParticipant').value.toLowerCase();
        let filterProgram = document.getElementById('filterProgram').value.toLowerCase();

        let rows = document.querySelectorAll('#participantTable tbody tr');
        let isHead = document.querySelector('#selectAllCheckbox') != null;

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            // Ambil text program (index bergeser tergantung role Head/Staff)
            let programText = row.cells[isHead ? 1 : 0].innerText.toLowerCase();

            let matchSearch = text.includes(searchText);
            let matchProgram = filterProgram === "" || programText.includes(filterProgram);

            row.style.display = (matchSearch && matchProgram) ? '' : 'none';
        });
    }

    document.getElementById('searchParticipant').addEventListener('keyup', applyFilters);
    document.getElementById('filterProgram').addEventListener('change', applyFilters);

    // --- LOGIKA SORTING TABEL ---
    let currentSortCol = -1;
    let asc = true;

    function sortTable(columnIndex) {
        let table = document.getElementById("participantTable");
        let tbody = table.querySelector("tbody");
        let rows = Array.from(tbody.querySelectorAll("tr"));

        asc = currentSortCol === columnIndex ? !asc : true;
        currentSortCol = columnIndex;

        rows.sort((a, b) => {
            let cellA = a.cells[columnIndex];
            let cellB = b.cells[columnIndex];

            let valA = cellA.hasAttribute("data-sort") ? cellA.getAttribute("data-sort") : cellA.innerText.trim().toLowerCase();
            let valB = cellB.hasAttribute("data-sort") ? cellB.getAttribute("data-sort") : cellB.innerText.trim().toLowerCase();

            if (valA < valB) return asc ? -1 : 1;
            if (valA > valB) return asc ? 1 : -1;
            return 0;
        });

        rows.forEach(row => tbody.appendChild(row));
    }

    // --- LOGIKA BULK DELETE (SELECT MULTIPLE) ---
    function toggleSelectAll(source) {
        const checkboxes = document.querySelectorAll('.chk-participant');
        // Hanya centang baris yang sedang tidak di-hide oleh filter pencarian
        checkboxes.forEach(cb => {
            if(cb.closest('tr').style.display !== 'none') {
                cb.checked = source.checked;
            }
        });
        toggleBulkDeleteBtn();
    }

    function toggleBulkDeleteBtn() {
        const checked = document.querySelectorAll('.chk-participant:checked');
        const btn = document.getElementById('btnBulkDelete');
        const countSpan = document.getElementById('bulkCount');
        const selectAllCb = document.getElementById('selectAllCheckbox');

        if (btn && countSpan) {
            countSpan.innerText = checked.length;
            if (checked.length > 0) {
                btn.classList.remove('d-none');
            } else {
                btn.classList.add('d-none');
                if (selectAllCb) selectAllCb.checked = false;
            }
        }
    }

    function submitBulkDelete() {
        const checked = document.querySelectorAll('.chk-participant:checked');
        if (checked.length === 0) return;

        if (!confirm(`PERINGATAN KRITIKAL:\n\nYakin ingin menghapus ${checked.length} data peserta yang dipilih beserta seluruh jawaban dan hasil tesnya secara permanen?`)) {
            return;
        }

        const form = document.getElementById('bulkDeleteForm');

        // Amankan Antiforgery Token (Jika ASP.NET render form kosong dengan asp-action, token otomatis dibuat di dalamnya)
        const token = form.querySelector('input[name="__RequestVerificationToken"]');
        form.innerHTML = '';
        if(token) form.appendChild(token);

        // Inject ID yang dipilih ke form tersembunyi
        checked.forEach(cb => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selectedIds'; // Harus sama dengan parameter List<Guid> di Controller
            input.value = cb.value;
            form.appendChild(input);
        });

        form.submit();
    }

    // --- LOGIKA POP-UP MODAL KUSTOM ---
    function showCustomAlert(missingTests) {
        document.getElementById('missingTestsText').innerText = missingTests;
        var myModal = new bootstrap.Modal(document.getElementById('incompleteModal'));
        myModal.show();
    }
</script>