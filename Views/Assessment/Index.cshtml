@{
    Layout = "~/Views/Shared/_AssessmentLayout.cshtml";
    ViewData["Title"] = "Pilih Asesmen";
}

<h3 class="fw-bold text-purple-brand fst-italic mb-4 opacity-75 text-left" style="font-size: 1.65rem;">Pilih jenis asesmen</h3>
<div class="d-flex flex-column gap-3">
    <!-- Mengubah text-start menjadi text-center -->
    <a href="@Url.Action("BiodataBasic", new { type = "Exploration" })" class="btn text-center fst-italic p-4 rounded-4 shadow-sm hover-card-select">
