        <span class="small fw-bold">(SMA/Sederajat)</span>
    </a>

    <a href="@Url.Action("ComingSoon")" class="btn text-center fst-italic p-4 rounded-4 shadow-sm hover-card-select">
        <span class="fw-bolder d-block fs-4">Advanced</span>
        <span class="small fw-bold">(Dewasa/Mahasiswa/Pekerja)</span>
