@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "IST 08 - WU (Würfelaufgaben)";
    ViewData["SubTestName"] = "IST 08: WU (Würfelaufgaben)";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    .btn-wu-option {
        border: 1.5px solid #EFE8D8;
        background-color: #FFFDF4;
        color: #4E325A;
        font-weight: 700;
        transition: all 0.15s ease;
        padding: 0.5rem;
        font-size: 0.95rem;
    }

    .btn-check:checked + .btn-wu-option {
        background-color: #4E325A !important;
        color: #FFE375 !important;
        border-color: #4E325A !important;
    }

    .btn-wu-option:hover {
        background-color: #F5EBF8;
        border-color: #9C7BB4;
    }

    .reference-box {
        border: 2px dashed #4E325A;
        background-color: #FAF6FF;
    }

    .intro-cube-img {
        max-height: 75px;
        object-fit: contain;
    }

    .example-box {
        background-color: #FFFDF4;
        border-left: 4px solid #4E325A;
    }
</style>

<form id="ist8Form">
    @Html.AntiForgeryToken()
    <input type="hidden" id="UserAssessmentId" value="@ViewBag.UserAssessmentId" />

    <!-- STICKY REFERENCE HEADER UNTUK SOAL 137-156 -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 reference-box sticky-top" style="top: 70px; z-index: 1020;">
        <h6 class="fw-bold text-purple-main mb-2 text-center small text-uppercase">Kubus Acuan Soal 137 - 156</h6>
        <div class="d-flex justify-content-around align-items-center flex-wrap gap-2">
            <div class="text-center"><img src="/images/IST-8/intro-a.png" class="intro-cube-img d-block mb-1" /><span class="fw-bold small">a</span></div>
            <div class="text-center"><img src="/images/IST-8/intro-b.png" class="intro-cube-img d-block mb-1" /><span class="fw-bold small">b</span></div>
            <div class="text-center"><img src="/images/IST-8/intro-c.png" class="intro-cube-img d-block mb-1" /><span class="fw-bold small">c</span></div>
            <div class="text-center"><img src="/images/IST-8/intro-d.png" class="intro-cube-img d-block mb-1" /><span class="fw-bold small">d</span></div>
            <div class="text-center"><img src="/images/IST-8/intro-e.png" class="intro-cube-img d-block mb-1" /><span class="fw-bold small">e</span></div>
        </div>
    </div>

    <!-- SOAL UTAMA -->
    <div id="questionsContainer" class="row g-3 mb-4"></div>

    <div class="text-end mb-5">
        <button type="button" id="btnSubmit" onclick="submitIst8()" class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm w-100 w-md-auto">
            Kirim & Lanjut ke IST Sub-Test 09
        </button>
    </div>
</form>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.QuestionsJson ?? "[]"))';
        let questions = [];

        try {
            questions = JSON.parse(rawJson);
        } catch (e) {
            console.error("Gagal parsing JSON IST 8:", e);
        }

        const container = document.getElementById('questionsContainer');
        let isSubmitting = false;

        const options = ['a', 'b', 'c', 'd', 'e'];

        // Render Soal WU
        if (Array.isArray(questions) && questions.length > 0) {
            questions.forEach((q) => {
                const cardCol = document.createElement('div');
                cardCol.className = 'col-12 col-md-6';

                let optionsHtml = '';
                options.forEach((opt) => {
                    const optId = `IST8_Q${q.id}_${opt}`;
                    optionsHtml += `
                        <div class="col">
                            <input type="radio" class="btn-check" name="IST8_Q${q.id}" id="${optId}" value="${opt}" autocomplete="off">
                            <label class="btn btn-wu-option w-100 rounded-3 text-center text-uppercase" for="${optId}">${opt}</label>
                        </div>
                    `;
                });

                cardCol.innerHTML = `
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="fw-bold text-purple-main mb-2">${q.id}. Position:</div>
                            <div class="text-center my-2 bg-light rounded-3 p-2 border">
                                <img src="${q.imagePath}" alt="Soal ${q.id}" class="img-fluid" style="max-height: 120px; object-fit: contain;" />
                            </div>
                        </div>
                        <div class="row g-2 mt-2">${optionsHtml}</div>
                    </div>
                `;

                container.appendChild(cardCol);
            });
        }

        // Timer 9 Menit (540 detik)
        let duration = 540;
        const countdown = setInterval(() => {
            if (isSubmitting) { clearInterval(countdown); return; }

            let m = Math.floor(duration / 60);
            let s = duration % 60;
            const formattedTime = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;

            const headerTimer = document.getElementById('timerDisplay');
            if (headerTimer) headerTimer.textContent = formattedTime;

            document.querySelectorAll('.timer-text').forEach(el => el.textContent = formattedTime);

            if (--duration < 0) {
                clearInterval(countdown);
                alert("Waktu pengerjaan IST Sub-Test 08 habis! Jawaban otomatis dikirim.");
                submitIst8();
            }
        }, 1000);

        async function submitIst8() {
            if (isSubmitting) return;

            const userAssessmentId = document.getElementById('UserAssessmentId').value;
            if (!userAssessmentId || userAssessmentId === "00000000-0000-0000-0000-000000000000") {
                alert("Session Assessment ID tidak terdeteksi.");
                return;
            }

            isSubmitting = true;

            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memproses...';

            const answers = {};
            questions.forEach(q => {
                const selected = document.querySelector(`input[name="IST8_Q${q.id}"]:checked`);
                answers[`Q${q.id}`] = selected ? selected.value : "";
            });

            const payload = {
                UserAssessmentId: userAssessmentId,
                SubTestName: "IST_SubTest_08",
                Answers: answers
            };

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Assessment/SubmitSubTest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement ? tokenElement.value : ''
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    window.location.href = `/Quiz/Instruction?testKey=IST_SubTest_09&userAssessmentId=${userAssessmentId}`;
                } else {
                    const errData = await response.json().catch(() => ({}));
                    alert("Gagal menyimpan IST 08: " + (errData.message || response.status));
                    resetSubmitState();
                }
            } catch (e) {
                alert("Koneksi bermasalah.");
                resetSubmitState();
            }
        }

        function resetSubmitState() {
            isSubmitting = false;
            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Kirim & Lanjut ke IST Sub-Test 09';
        }
    </script>
}