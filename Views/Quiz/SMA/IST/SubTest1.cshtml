@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "IST 01 - SE (Satzergänzung)";
    ViewData["SubTestName"] = "IST 01: SE (Satzergänzung)";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    .btn-ist-option {
        border: 1.5px solid #EFE8D8;
        background-color: #FFFDF4;
        color: #4E325A;
        font-weight: 500;
        transition: all 0.15s ease;
        padding: 0.75rem 0.5rem;
        font-size: clamp(0.85rem, 1.4vw, 1rem);
    }

    .btn-check:checked + .btn-ist-option {
        background-color: #4E325A !important;
        color: #FFE375 !important;
        border-color: #4E325A !important;
    }

    .btn-ist-option:hover {
        background-color: #F5EBF8;
        border-color: #9C7BB4;
    }
</style>

<!-- Header & Timer Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
        <h6 class="fw-bold text-dark m-0">Instruksi IST Kelompok Soal 01 (SE)</h6>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Sisa Waktu:</span>
            <span class="badge rounded-pill px-3 py-2 fs-6 bg-purple-main text-warning timer-text">06:00</span>
        </div>
    </div>
    <p class="text-muted small mb-0 lh-sm">
        Soal 01–20 terdiri atas kalimat-kalimat. Pada setiap kalimat, satu kata hilang. Pilihlah kata yang tepat untuk menyempurnakan kalimat tersebut.
    </p>
</div>

<form id="ist1Form">
    @Html.AntiForgeryToken()
    <input type="hidden" id="UserAssessmentId" value="@ViewBag.UserAssessmentId" />

    <div id="questionsContainer" class="d-flex flex-column gap-3 mb-4"></div>

    <div class="text-end mb-5">
        <button type="button" id="btnSubmit" onclick="submitIst1()" class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm w-100 w-md-auto">
            Kirim & Lanjut ke IST Sub-Test 02
        </button>
    </div>
</form>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.QuestionsJson ?? "[]"))';
        let questions = [];

        try {
            questions = JSON.parse(rawJson);
        } catch (e) {
            console.error("Gagal parsing JSON IST 1:", e);
        }

        const container = document.getElementById('questionsContainer');
        let isSubmitting = false;

        // Render Soal
        if (Array.isArray(questions) && questions.length > 0) {
            questions.forEach((q) => {
                const card = document.createElement('div');
                card.className = 'card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white';

                let optionsHtml = '';
                q.options.forEach((opt) => {
                    const optId = `IST1_Q${q.id}_${opt.code}`;
                    optionsHtml += `
                        <div class="col-12 col-md">
                            <input type="radio" class="btn-check" name="IST1_Q${q.id}" id="${optId}" value="${opt.code}" autocomplete="off">
                            <label class="btn btn-ist-option w-100 rounded-3 text-truncate" for="${optId}">${opt.code.toUpperCase()}) ${opt.text}</label>
                        </div>
                    `;
                });

                card.innerHTML = `
                    <div class="fw-bold text-purple-main mb-3 fs-6">${q.id}. ${q.sentence}</div>
                    <div class="row g-2">${optionsHtml}</div>
                `;
                container.appendChild(card);
            });
        }

        // Timer 6 Menit (360 detik)
        let duration = 360;
        const countdown = setInterval(() => {
            if (isSubmitting) { clearInterval(countdown); return; }

            let m = Math.floor(duration / 60);
            let s = duration % 60;
            const formattedTime = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;

            const headerTimer = document.getElementById('timerDisplay');
            if (headerTimer) headerTimer.textContent = formattedTime;

            document.querySelectorAll('.timer-text').forEach(el => el.textContent = formattedTime);

            if (--duration < 0) {
                clearInterval(countdown);
                alert("Waktu pengerjaan IST Sub-Test 01 habis! Jawaban otomatis dikirim.");
                submitIst1();
            }
        }, 1000);

                async function submitIst1() {
            if (isSubmitting) return;

            const userAssessmentId = document.getElementById('UserAssessmentId').value;

            // Sanity check sebelum melakukan fetch
            if (!userAssessmentId || userAssessmentId === "00000000-0000-0000-0000-000000000000") {
                alert("Session Assessment ID tidak ditemukan. Mengembalikan ke pendaftaran.");
                window.location.href = "/Assessment/Index";
                return;
            }

            isSubmitting = true;

            const answers = {};
            questions.forEach(q => {
                const selected = document.querySelector(`input[name="IST1_Q${q.id}"]:checked`);
                answers[`Q${q.id}`] = selected ? selected.value : "";
            });

            const payload = {
                UserAssessmentId: userAssessmentId,
                SubTestName: "IST_SubTest_01",
                Answers: answers
            };

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Assessment/SubmitSubTest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement ? tokenElement.value : ''
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    // Forward ID ke SubTest 2
                    window.location.href = `/Quiz/IstSubTest2?userAssessmentId=${userAssessmentId}`;
                } else {
                    const errData = await response.json();
                    alert("Gagal menyimpan IST 01: " + (errData.message || response.status));
                    resetSubmitState();
                }
            } catch (e) {
                alert("Koneksi bermasalah.");
                resetSubmitState();
            }
        }

        function resetSubmitState() {
            isSubmitting = false;
            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Kirim & Lanjut ke IST Sub-Test 02';
        }
    </script>
}