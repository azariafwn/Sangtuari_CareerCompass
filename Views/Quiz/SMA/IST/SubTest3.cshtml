@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "IST 03 - AN (Analogien)";
    ViewData["SubTestName"] = "IST 03: AN (Analogien)";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    .btn-ist-option {
        border: 1.5px solid #EFE8D8;
        background-color: #FFFDF4;
        color: #4E325A;
        font-weight: 500;
        transition: all 0.15s ease;
        padding: 0.75rem 0.5rem;
        font-size: clamp(0.85rem, 1.4vw, 1rem);
    }

    .btn-check:checked + .btn-ist-option {
        background-color: #4E325A !important;
        color: #FFE375 !important;
        border-color: #4E325A !important;
    }

    .btn-ist-option:hover {
        background-color: #F5EBF8;
        border-color: #9C7BB4;
    }
</style>

<!-- Header & Timer Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
        <h6 class="fw-bold text-dark m-0">Instruksi IST Kelompok Soal 03 (AN)</h6>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Sisa Waktu:</span>
            <span class="badge rounded-pill px-3 py-2 fs-6 bg-purple-main text-warning timer-text">07:00</span>
        </div>
    </div>
    <p class="text-muted small mb-0 lh-sm">
        Ditentukan 3 kata. Antara kata pertama dan kedua terdapat hubungan tertentu. Carilah kata dari pilihan (a–e) yang mempunyai <strong>hubungan sepadan dengan kata ketiga</strong>!
    </p>
</div>

<form id="ist3Form">
    @Html.AntiForgeryToken()
    <input type="hidden" id="UserAssessmentId" value="@ViewBag.UserAssessmentId" />

    <div id="questionsContainer" class="d-flex flex-column gap-3 mb-4"></div>

    <div class="text-end mb-5">
        <button type="button" id="btnSubmit" onclick="submitIst3()" class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm w-100 w-md-auto">
            Kirim & Lanjut ke IST Sub-Test 04
        </button>
    </div>
</form>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.QuestionsJson ?? "[]"))';
        let questions = [];

        try {
            questions = JSON.parse(rawJson);
        } catch (e) {
            console.error("Gagal parsing JSON IST 3:", e);
        }

        const container = document.getElementById('questionsContainer');
        let isSubmitting = false;

        // Render Soal
        if (Array.isArray(questions) && questions.length > 0) {
            questions.forEach((q) => {
                const card = document.createElement('div');
                card.className = 'card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white';

                let optionsHtml = '';
                q.options.forEach((opt) => {
                    const optId = `IST3_Q${q.id}_${opt.code}`;
                    optionsHtml += `
                        <div class="col-12 col-md">
                            <input type="radio" class="btn-check" name="IST3_Q${q.id}" id="${optId}" value="${opt.code}" autocomplete="off">
                            <label class="btn btn-ist-option w-100 rounded-3 text-truncate" for="${optId}">${opt.code.toUpperCase()}) ${opt.text}</label>
                        </div>
                    `;
                });

                card.innerHTML = `
                    <div class="fw-bold text-purple-main mb-3 fs-6">${q.id}. ${q.premise}</div>
                    <div class="row g-2">${optionsHtml}</div>
                `;
                container.appendChild(card);
            });
        }

        // Timer 7 Menit (420 detik)
        let duration = 420;
        const countdown = setInterval(() => {
            if (isSubmitting) { clearInterval(countdown); return; }

            let m = Math.floor(duration / 60);
            let s = duration % 60;
            const formattedTime = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;

            const headerTimer = document.getElementById('timerDisplay');
            if (headerTimer) headerTimer.textContent = formattedTime;

            document.querySelectorAll('.timer-text').forEach(el => el.textContent = formattedTime);

            if (--duration < 0) {
                clearInterval(countdown);
                alert("Waktu pengerjaan IST Sub-Test 03 habis! Jawaban otomatis dikirim.");
                submitIst3();
            }
        }, 1000);

        async function submitIst3() {
            if (isSubmitting) return;

            const userAssessmentId = document.getElementById('UserAssessmentId').value;
            if (!userAssessmentId || userAssessmentId === "00000000-0000-0000-0000-000000000000") {
                alert("Session Assessment ID tidak terdeteksi.");
                return;
            }

            isSubmitting = true;

            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memproses...';

            const answers = {};
            questions.forEach(q => {
                const selected = document.querySelector(`input[name="IST3_Q${q.id}"]:checked`);
                answers[`Q${q.id}`] = selected ? selected.value : "";
            });

            const payload = {
                UserAssessmentId: userAssessmentId,
                SubTestName: "IST_SubTest_03",
                Answers: answers
            };

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Assessment/SubmitSubTest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement ? tokenElement.value : ''
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    window.location.href = `/Quiz/IstSubTest4?userAssessmentId=${userAssessmentId}`;
                } else {
                    const errData = await response.json().catch(() => ({}));
                    alert("Gagal menyimpan IST 03: " + (errData.message || response.status));
                    resetSubmitState();
                }
            } catch (e) {
                alert("Koneksi bermasalah.");
                resetSubmitState();
            }
        }

        function resetSubmitState() {
            isSubmitting = false;
            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Kirim & Lanjut ke IST Sub-Test 04';
        }
    </script>
}