@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "Petunjuk & Instruksi Tes";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    .instruction-card {
        border-left: 6px solid #4E325A;
    }

    .reference-box {
        border: 2px dashed #4E325A;
        background-color: #FAF6FF;
    }

    .example-box {
        background-color: #FFFDF4;
        border-left: 4px solid #4E325A;
    }

    .option-example-card {
        border: 1px solid #EFE8D8;
        background-color: #FFFFFF;
        border-radius: 8px;
        padding: 4px;
        text-align: center;
    }

    .option-example-img {
        max-height: 45px;
        object-fit: contain;
    }
</style>

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white instruction-card">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-3 mb-4 gap-3">
            <div>
                <span class="badge bg-purple-main text-warning rounded-pill px-3 py-1 mb-2 fs-6" id="testCategory">Kategori Tes</span>
                <h3 class="fw-bold text-dark m-0" id="testTitle">Nama Tes</h3>
            </div>
            <div id="durationBadge" class="text-md-end">
                <span class="text-muted small d-block">Alokasi Waktu</span>
                <span class="fw-bold text-purple-main fs-4" id="testDuration">-</span>
            </div>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold text-dark mb-2 fs-6">Petunjuk Pengerjaan:</h6>
            <p class="text-muted lh-base mb-0" id="testDescription">-</p>
        </div>

        <!-- Section Gambar Acuan (Jika Ada) -->
        <div id="referenceImagesContainer" class="mb-4 p-3 reference-box rounded-4 d-none">
            <h6 class="fw-bold text-purple-main mb-3 text-center small text-uppercase">Bentuk Acuan Utama</h6>
            <div id="referenceImagesList" class="d-flex justify-content-around align-items-center flex-wrap gap-2"></div>
        </div>

        <!-- Section Contoh Soal & Penjelasan (Jika Ada) -->
        <div id="examplesContainer" class="mb-4 d-none">
            <h6 class="fw-bold text-dark mb-3 fs-6">Contoh Soal & Penjelasan:</h6>
            <div id="examplesList" class="row g-3"></div>
        </div>

        <div class="alert alert-warning rounded-4 border-0 d-flex align-items-center gap-3 py-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning flex-shrink-0"></i>
            <span class="small text-dark mb-0">
                Pastikan Anda siap. Timer pengerjaan soal akan langsung berjalan begitu Anda menekan tombol di bawah!
            </span>
        </div>

        <div class="text-end">
            <button type="button" id="btnStartQuiz" class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm w-100 w-md-auto fs-6">
                Saya Paham, Mulai Tes Sekarang <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.InstructionsJson ?? "{}"))';
        const testKey = '@ViewBag.TestKey';
        const userAssessmentId = '@ViewBag.UserAssessmentId';

        let config = {};
        try {
            const allConfig = JSON.parse(rawJson);
            config = allConfig[testKey] || {};
        } catch (e) {
            console.error("Gagal parsing JSON instruksi:", e);
        }

        document.getElementById('testCategory').textContent = config.category || 'Petunjuk';
        document.getElementById('testTitle').textContent = config.title || 'Instruksi Asesmen';
        document.getElementById('testDescription').textContent = config.description || 'Silakan baca petunjuk dengan teliti.';

        document.getElementById('testDuration').textContent = config.durationMinutes > 0
            ? `${config.durationMinutes} Menit`
            : 'Tanpa Batas Waktu';

        // Render Gambar Acuan
        if (config.referenceImages && Array.isArray(config.referenceImages) && config.referenceImages.length > 0) {
            const refBox = document.getElementById('referenceImagesContainer');
            const refList = document.getElementById('referenceImagesList');
            refBox.classList.remove('d-none');

            const letters = ['a', 'b', 'c', 'd', 'e'];
            config.referenceImages.forEach((imgUrl, idx) => {
                const div = document.createElement('div');
                div.className = 'text-center';
                div.innerHTML = `
                    <img src="${imgUrl}" class="img-fluid bg-white p-1 rounded-3 border d-block mb-1" style="max-height: 75px; object-fit: contain;" />
                    <span class="fw-bold small text-purple-main text-uppercase">${letters[idx] || ''}</span>
                `;
                refList.appendChild(div);
            });
        }

        // Render Contoh Soal
        if (config.examples && Array.isArray(config.examples) && config.examples.length > 0) {
            const exBox = document.getElementById('examplesContainer');
            const exList = document.getElementById('examplesList');
            exBox.classList.remove('d-none');

            config.examples.forEach(ex => {
                const col = document.createElement('div');
                col.className = 'col-12 col-md-6';

                let optionsHtml = '';
                if (ex.options && Array.isArray(ex.options) && ex.options.length > 0) {
                    let optCols = '';
                    ex.options.forEach(opt => {
                        optCols += `
                            <div class="col">
                                <div class="option-example-card">
                                    <span class="fw-bold text-purple-main text-uppercase small d-block mb-1">${opt.code}</span>
                                    <img src="${opt.imagePath}" class="img-fluid option-example-img" />
                                </div>
                            </div>
                        `;
                    });
                    optionsHtml = `<div class="row g-1 my-2">${optCols}</div>`;
                }

                col.innerHTML = `
                    <div class="example-box rounded-4 p-3 h-100 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-purple-main text-warning mb-2">${ex.title}</span>
                            ${ex.imagePath ? `<div class="text-center my-2"><img src="${ex.imagePath}" class="img-fluid rounded border bg-white p-2" style="max-height: 100px; object-fit: contain;" /></div>` : ''}
                            ${optionsHtml}
                        </div>
                        <div class="mt-2 border-top pt-2">
                            <p class="small fw-bold text-dark mb-1">${ex.answer}</p>
                            <p class="small text-muted mb-0">${ex.explanation}</p>
                        </div>
                    </div>
                `;
                exList.appendChild(col);
            });
        }

        document.getElementById('btnStartQuiz').onclick = function() {
            if (config.nextActionUrl) {
                window.location.href = `${config.nextActionUrl}?userAssessmentId=${userAssessmentId}`;
            } else {
                alert("URL modul tes belum dikonfigurasi.");
            }
        };
    </script>
}