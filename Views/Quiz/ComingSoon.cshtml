@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "Coming Soon";
    var userAssessmentId = Context.Request.Query["userAssessmentId"].ToString();
    var currentSubTest = ViewData["SubTestName"]?.ToString() ?? "";
}

<div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-5">
    <div class="mb-3">
        <span class="badge rounded-pill bg-purple-main text-warning px-4 py-2 fs-6 fw-bold">Modul Dalam Pengembangan</span>
    </div>
    <h3 class="fw-bold text-dark mb-2">@ViewData["SubTestName"]</h3>
    <p class="text-muted mb-4">
        Terima kasih telah menyelesaikan pendaftaran. Sub-test ini sedang disiapkan dan akan segera tersedia.
    </p>

    <div class="d-flex justify-content-center gap-3">
        <!-- Jika berada di CFIT, berikan opsi tombol navigasi langsung ke EAS 1 -->
        @if (currentSubTest.Contains("CFIT"))
        {
            <a href="@Url.Action("Eas1", "Quiz", new { userAssessmentId = userAssessmentId })" class="btn btn-purple-custom rounded-pill px-5 py-2.5 fw-bold shadow-sm">
                Lanjut ke EAS 1
            </a>
        }
        else
        {
            <a href="@Url.Action("Index", "Assessment")" class="btn btn-purple-custom rounded-pill px-5 py-2.5 fw-bold shadow-sm">
                Kembali ke Halaman Utama
            </a>
        }
    </div>
</div>