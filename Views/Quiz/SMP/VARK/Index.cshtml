@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "Kuesioner Gaya Belajar (VARK)";
    ViewData["SubTestName"] = "VARK Learning Style";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    .vark-option-btn {
        border: 1.5px solid #EFE8D8;
        background-color: #FFFDF4;
        color: #4E325A;
        font-weight: 500;
        text-align: left;
        padding: 0.85rem 1rem;
        font-size: clamp(0.9rem, 1.4vw, 1rem);
        transition: all 0.2s ease;
        white-space: normal;
    }

    .btn-check:checked + .vark-option-btn {
        background-color: #F5EBF8 !important;
        color: #4E325A !important;
        border-color: #4E325A !important;
        box-shadow: inset 4px 0 0 #4E325A;
        font-weight: 600;
    }

    .vark-option-btn:hover {
        background-color: #F5EBF8;
        border-color: #9C7BB4;
    }
</style>

<!-- Card Instruksi VARK -->
<div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
        <h6 class="fw-bold text-dark m-0">Instruksi Kuesioner VARK</h6>
        <span class="badge rounded-pill px-3 py-2 fs-6 bg-purple-main text-warning">Tanpa Batas Waktu</span>
    </div>
    <p class="text-muted small mb-0 lh-sm">
        Pilihlah jawaban yang paling sesuai dengan kondisi Anda. <strong>Anda boleh memilih lebih dari satu pilihan</strong> jika memang ada lebih dari satu kondisi yang sesuai. Kosongkan pilihan jika tidak ada yang sesuai.
    </p>
</div>

<form id="varkForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="UserAssessmentId" value="@ViewBag.UserAssessmentId" />

    <div id="varkContainer" class="d-flex flex-column gap-3 mb-4"></div>

    <div class="text-end mb-5">
        <button type="button" id="btnSubmit" onclick="submitVark()" class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm w-100 w-md-auto">
            Kirim & Lanjut ke SDS Holland
        </button>
    </div>
</form>

@section Scripts {
    <script>
        // Membaca JSON Soal VARK secara aman
        const rawJson = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.QuestionsJson ?? "[]"))';
        let questions = [];

        try {
            questions = JSON.parse(rawJson);
        } catch (e) {
            console.error("Gagal parsing JSON VARK:", e);
        }

        const container = document.getElementById('varkContainer');
        let isSubmitting = false;

        // Set Timer Header ke "--:--" karena Tanpa Batas Waktu
        const headerTimer = document.getElementById('timerDisplay');
        if (headerTimer) {
            headerTimer.textContent = "--:--";
        }

        // Render Soal VARK
        if (Array.isArray(questions) && questions.length > 0) {
            container.innerHTML = ''; // Clear container
            questions.forEach((q) => {
                const card = document.createElement('div');
                card.className = 'card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-3';

                let optionsHtml = '';
                q.options.forEach((opt) => {
                    const optId = `VARK_Q${q.id}_${opt.code}`;
                    optionsHtml += `
                        <div class="col-12">
                            <input type="checkbox" class="btn-check" name="VARK_Q${q.id}" id="${optId}" value="${opt.code}" data-category="${opt.category}" autocomplete="off">
                            <label class="btn vark-option-btn w-100 rounded-3 d-flex align-items-start gap-2" for="${optId}">
                                <span class="fw-bold">${opt.code.toUpperCase()}.</span>
                                <span>${opt.text}</span>
                            </label>
                        </div>
                    `;
                });

                card.innerHTML = `
                    <div class="fw-bold text-purple-main fs-6 mb-3">${q.id}. ${q.question}</div>
                    <div class="row g-2">${optionsHtml}</div>
                `;
                container.appendChild(card);
            });
        } else {
            container.innerHTML = `
                <div class="alert alert-warning rounded-4 text-center">
                    Data soal VARK belum dimuat. Pastikan file <code>Data/Quiz/VARK/varkQuestion.json</code> sudah diset <strong>Copy if newer</strong> di Visual Studio.
                </div>
            `;
        }

                async function submitVark() {
            if (isSubmitting) return;

            // AMBIL USER ASSESSMENT ID DI AWAL FUNGSI
            const userAssessmentId = document.getElementById('UserAssessmentId').value;
            if (!userAssessmentId || userAssessmentId === "00000000-0000-0000-0000-000000000000") {
                alert("Session Assessment ID tidak terdeteksi. Mengembalikan ke pendaftaran.");
                window.location.href = "/Assessment/Index";
                return;
            }

            isSubmitting = true;

            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memproses...';

            const answers = {};
            const categoryScores = { V: 0, A: 0, R: 0, K: 0 };

            questions.forEach(q => {
                const selectedChecked = document.querySelectorAll(`input[name="VARK_Q${q.id}"]:checked`);
                const selectedCodes = [];

                selectedChecked.forEach(cb => {
                    selectedCodes.push(cb.value);
                    const cat = cb.getAttribute('data-category');
                    if (categoryScores[cat] !== undefined) {
                        categoryScores[cat]++;
                    }
                });

                answers[`Q${q.id}`] = selectedCodes;
            });

            const payload = {
                UserAssessmentId: userAssessmentId,
                SubTestName: "VARK",
                Answers: {
                    UserResponses: answers,
                    Scores: categoryScores
                }
            };

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Assessment/SubmitSubTest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement ? tokenElement.value : ''
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    // TRANSIT KE HALAMAN JEDA INSTRUKSI SDS HOLLAND
                    window.location.href = `/Quiz/SdsHolland?userAssessmentId=${userAssessmentId}`;
                } else {
                    alert("Gagal menyimpan jawaban VARK. Status: " + response.status);
                    resetSubmitState();
                }
            } catch (e) {
                console.error("Submit VARK Error Detail:", e);
                alert("Terjadi kesalahan teknis saat mengirim data: " + e.message);
                resetSubmitState();
            }
        }
        function resetSubmitState() {
            isSubmitting = false;
            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Kirim & Lanjut ke SDS Holland';
        }
    </script>
}