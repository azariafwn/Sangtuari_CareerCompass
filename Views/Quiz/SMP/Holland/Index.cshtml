@{
    Layout = "~/Views/Shared/_QuizLayout.cshtml";
    ViewData["Title"] = "SDS Holland Interest Test (RIASEC)";
    ViewData["SubTestName"] = "SDS Holland Interest Test";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    /* CSS Grid untuk mengunci alignment kolom teks dan tombol */
    .holland-row {
        display: grid;
        grid-template-columns: 1fr 120px 120px; /* Kolom 1 fleksibel, Kolom YA 120px, Kolom TIDAK 120px */
        gap: 12px;
        align-items: center;
    }
  
    @@media (max-width: 575.98px) {
        .holland-row {
            grid-template-columns: 1fr 90px 90px;
            gap: 8px;
        }
    }

    .btn-riasec-option {
        border: 1.5px solid #EFE8D8;
        background-color: #FFFDF4;
        color: #4E325A;
        font-weight: 600;
        padding: 0.65rem 0.2rem;
        font-size: 0.95rem;
        transition: all 0.15s ease;
    }

    .btn-check:checked + .btn-riasec-option {
        background-color: #4E325A !important;
        color: #FFE375 !important;
        border-color: #4E325A !important;
    }

    .btn-riasec-option:hover {
        background-color: #F5EBF8;
        border-color: #9C7BB4;
    }
</style>

<form id="hollandForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="UserAssessmentId" value="@ViewBag.UserAssessmentId" />

    <div id="hollandContainer" class="d-flex flex-column gap-3 mb-4"></div>

    <div class="text-end mb-5">
        <button type="button" id="btnSubmit" onclick="submitHolland()" class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm w-100 w-md-auto">
            Kirim & Selesaikan Asesmen
        </button>
    </div>
</form>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ViewBag.QuestionsJson ?? "[]"))';
        let questions = [];

        try {
            questions = JSON.parse(rawJson);
        } catch (e) {
            console.error("Gagal parsing JSON Holland:", e);
        }

        const container = document.getElementById('hollandContainer');
        let isSubmitting = false;

        // Reset Header Timer ke --:--
        const headerTimer = document.getElementById('timerDisplay');
        if (headerTimer) headerTimer.textContent = "--:--";

        // Render 108 Soal
                // Render 108 Soal dengan CSS Grid Alignment
        if (Array.isArray(questions) && questions.length > 0) {
            container.innerHTML = '';
            questions.forEach((q) => {
                const card = document.createElement('div');
                card.className = 'card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-2';

                const optYes = `HOLLAND_Q${q.id}_YES`;
                const optNo = `HOLLAND_Q${q.id}_NO`;

                card.innerHTML = `
                    <div class="holland-row">
                        <!-- Kolom 1: Teks Pernyataan -->
                        <div class="fw-medium text-dark pe-2">
                            <span class="fw-bold text-purple-main me-1">${q.id}.</span> ${q.statement}
                        </div>

                        <!-- Kolom 2: Tombol YA (Lebar Terkunci) -->
                        <div>
                            <input type="radio" class="btn-check" name="HOLLAND_Q${q.id}" id="${optYes}" value="YA" data-category="${q.category}" autocomplete="off">
                            <label class="btn btn-riasec-option w-100 rounded-3 text-center" for="${optYes}">YA</label>
                        </div>

                        <!-- Kolom 3: Tombol TIDAK (Lebar Terkunci) -->
                        <div>
                            <input type="radio" class="btn-check" name="HOLLAND_Q${q.id}" id="${optNo}" value="TIDAK" data-category="${q.category}" autocomplete="off">
                            <label class="btn btn-riasec-option w-100 rounded-3 text-center" for="${optNo}">TIDAK</label>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        } else {
            container.innerHTML = `
                <div class="alert alert-warning rounded-4 text-center">
                    Data soal Holland belum dimuat. Pastikan file <code>Data/Quiz/Holland/hollandQuestion.json</code> sudah diset <strong>Copy if newer</strong> di Visual Studio.
                </div>
            `;
        }

        async function submitHolland() {
            if (isSubmitting) return;
            isSubmitting = true;

            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memproses...';

            // Ambil assessmentId ke variabel lokal
            const assessmentId = document.getElementById('UserAssessmentId').value;

            const answers = {};
            const scores = { R: 0, I: 0, A: 0, S: 0, E: 0, C: 0 };

            questions.forEach(q => {
                const selected = document.querySelector(`input[name="HOLLAND_Q${q.id}"]:checked`);
                const val = selected ? selected.value : "";
                answers[`Q${q.id}`] = val;

                if (val === "YA") {
                    const cat = q.category;
                    if (scores[cat] !== undefined) {
                        scores[cat]++;
                    }
                }
            });

            const payload = {
                UserAssessmentId: assessmentId,
                SubTestName: "SDS_Holland",
                Answers: {
                    UserResponses: answers,
                    Scores: scores
                }
            };

            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const response = await fetch('/Assessment/SubmitSubTest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenElement ? tokenElement.value : ''
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    // window.location.href = `/Report/SdsResult?userAssessmentId=${assessmentId}`;                    
                    window.location.href = `/Report/FinalReportSMA?userAssessmentId=${assessmentId}`;
                } else {
                    alert("Gagal menyimpan jawaban Holland Test.");
                    resetSubmitState();
                }
            } catch (e) {
                console.error("Submit Error:", e);
                alert("Koneksi bermasalah.");
                resetSubmitState();
            }
        }

        function resetSubmitState() {
            isSubmitting = false;
            const submitBtn = document.getElementById('btnSubmit');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Kirim & Selesaikan Asesmen';
        }
    </script>
}