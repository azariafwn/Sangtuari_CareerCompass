@model SangtuariCareerCompass.ViewModels.VarkReportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Hasil Inventori Gaya Belajar VARK";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
        color: #FFFFFF;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .bg-yellow-accent {
        background-color: #FFE375;
        color: #4E325A;
    }

    .card-report {
        background-color: #FFFDF4;
        border-radius: 20px;
        border: none;
    }
</style>

<div class="container py-5">
    <div class="card card-report shadow-sm p-4 p-md-5 mb-4">
        <!-- HEADER IDENTITAS PESERTA -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
            <div>
                <span class="badge bg-purple-main rounded-pill px-3 py-2 mb-2">Inventori Gaya Belajar (VARK)</span>
                <h2 class="fw-bold text-dark mb-1">@Model.FullName</h2>
                <p class="text-muted mb-0">@Model.SchoolName</p>
            </div>
            <div class="bg-yellow-accent p-3 rounded-4 text-center min-w-200">
                <span class="small fw-bold text-uppercase d-block mb-1">Gaya Belajar Dominan</span>
                <span class="fs-4 fw-bold text-purple-main">@Model.DominantCategoryText</span>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- PIE CHART VARK -->
            <div class="col-md-5 d-flex flex-column align-items-center justify-content-center border-end">
                <h6 class="fw-bold text-purple-main mb-3">Kecenderungan Gaya Belajar</h6>
                <div style="max-width: 280px; width: 100%;">
                    <canvas id="varkChart"></canvas>
                </div>
            </div>

            <!-- TABEL SKOR PER ASPEK -->
            <div class="col-md-7">
                <h6 class="fw-bold text-purple-main mb-3">Rincian Skor per Aspek</h6>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle bg-white rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th>Aspek Gaya Belajar</th>
                                <th class="text-center">Skor</th>
                                <th class="text-center">Persentase</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CategoryScores)
                            {
                                <tr>
                                    <td class="fw-semibold text-purple-main">@item.CategoryName (@item.CategoryCode)</td>
                                    <td class="text-center fw-bold">@item.Score</td>
                                    <td class="text-center">@item.Percentage%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- NARASI INTERPRETASI & REKOMENDASI METODE BELAJAR -->
        <div class="bg-white p-4 rounded-4 border mb-4">
            <h5 class="fw-bold text-purple-main mb-2"><i class="bi bi-journal-text me-2"></i>Interpretasi & Rekomendasi</h5>
            <p class="text-dark lh-base mb-2">@Model.InterpretationText</p>
            <p class="text-dark lh-base mb-0">@Model.RecommendedStudyMethods</p>
        </div>

        <!-- TOMBOL TRANSIT KE INSTRUMEN BERIKUTNYA -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-4 gap-3">
            <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-printer me-1"></i> Cetak Laporan VARK
            </button>
            <a href="/Quiz/Instruction?testKey=SDS_Holland&userAssessmentId=@Model.UserAssessmentId"
               class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm">
                Lanjut ke Instruksi SDS Holland Test <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Definisikan Pemetaan Warna Konsisten per Kategori
        const colorMap = {
            'V': '#4E325A', // Ungu Tua (Visual)
            'A': '#8C629E', // Ungu Muda (Aural/Auditori)
            'R': '#FFE375', // Kuning (Read/Write)
            'K': '#EFE8D8'  // Krem (Kinesthetic)
        };

        // 2. Serialisasi Data dari C# Model
        const categoryScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryScores));

        // 3. Petik Labels, Data Persentase, dan Warna secara Dinamis & Terurut
        const labels = categoryScores.map(c => c.CategoryName);
        const dataValues = categoryScores.map(c => c.Percentage);
        const dynamicColors = categoryScores.map(c => colorMap[c.CategoryCode] || '#CCCCCC');

        // 4. Render Pie Chart
        const ctx = document.getElementById('varkChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    data: dataValues,
                    backgroundColor: dynamicColors,
                    borderWidth: 2,
                    borderColor: '#FFFDF4'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            font: { family: "'Segoe UI', sans-serif", size: 12 },
                            padding: 15,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return ` ${context.label}: ${context.raw}%`;
                            }
                        }
                    }
                }
            }
        });
    });
</script>