@model SangtuariCareerCompass.ViewModels.IstReportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Psikogram Hasil Tes IST";
}

<style>
    .bg-purple-main {
        background-color: #4E325A;
        color: #FFFFFF;
    }

    .text-purple-main {
        color: #4E325A;
    }

    .bg-yellow-accent {
        background-color: #FFE375;
        color: #4E325A;
    }

    .btn-purple-custom {
        background-color: #4E325A;
        color: #FFE375;
        border: none;
    }

        .btn-purple-custom:hover {
            background-color: #3b2544;
            color: #ffffff;
        }

    .card-report {
        background-color: #FFFDF4;
        border-radius: 20px;
        border: none;
    }

    .table-ist th {
        background-color: #4E325A;
        color: #FFE375;
        font-size: 0.9rem;
    }

    .table-ist td {
        font-size: 0.88rem;
    }
</style>

<div class="container py-5">
    <div class="card card-report shadow-sm p-4 p-md-5 mb-4">
        <!-- HEADER IDENTITAS PESERTA -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center border-bottom pb-4 mb-4 gap-3">
            <div>
                <span class="badge bg-purple-main rounded-pill px-3 py-2 mb-2">Discovery Test (SMA)</span>
                <h2 class="fw-bold text-dark mb-1">@Model.FullName</h2>
                <p class="text-muted mb-0">@Model.SchoolName | Usia: <strong>@Model.Age Tahun</strong></p>
            </div>
            <div class="bg-yellow-accent p-3 rounded-4 text-center min-w-200">
                <span class="small fw-bold text-uppercase d-block mb-1">Skor IQ / Taraf Kecerdasan</span>
                <span class="display-5 fw-bold text-purple-main">@Model.CalculatedIQ</span>
                <span class="d-block badge bg-purple-main mt-1 fs-6">@Model.IQIntelligenceLevel (@Model.IQClassification)</span>
            </div>
        </div>

        <!-- TABEL PSIKOGRAM IST -->
        <h5 class="fw-bold text-purple-main mb-3"><i class="bi bi-bar-chart-line me-2"></i>Psikogram Hasil Tes IST</h5>
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-ist align-middle">
                <thead>
                    <tr class="text-center">
                        <th style="width: 80px;">Subtes</th>
                        <th style="width: 180px;">Nama Aspek</th>
                        <th style="width: 60px;">RW</th>
                        <th style="width: 80px;">SW</th>
                        <th style="width: 130px;">Kategori</th>
                        <th>Interpretasi & Uraian Aspek</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SubTestResults)
                    {
                        <tr>
                            <td class="text-center fw-bold text-purple-main">@item.SubTestCode</td>
                            <td class="fw-semibold">@item.AspectName</td>
                            <td class="text-center">@item.RawScore</td>
                            <td class="text-center fw-bold text-purple-main fs-6">@item.StandardScore</td>
                            <td class="text-center">
                                <span class="badge bg-purple-main rounded-pill px-3 py-1">@item.Category</span>
                            </td>
                            <td class="text-muted">@item.InterpretationText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- TOMBOL TRANSIT KE TEST BERIKUTNYA -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center border-top pt-4 gap-3">
            <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-printer me-1"></i> Cetak Laporan IST
            </button>
            <a href="/Quiz/Instruction?testKey=PAPI_Kostick&userAssessmentId=@Model.UserAssessmentId"
               class="btn btn-purple-custom rounded-pill px-5 py-3 fw-bold shadow-sm">
                Lanjut ke Instruksi PAPI Kostick <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>